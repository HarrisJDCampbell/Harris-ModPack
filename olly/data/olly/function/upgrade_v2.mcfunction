# Ollys blessed by v1.0 were made 15% BIGGER. The real Olly is smaller than a wolf,
# so swap the old size modifier for the Olly-sized one, once per dog.
attribute @s minecraft:generic.scale modifier remove olly:good_boy_size
attribute @s minecraft:generic.scale modifier add olly:olly_sized -0.2 add_multiplied_base
tag @s add olly.v2
